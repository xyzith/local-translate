{
  "manifest_version": 3,
  "name": "本機翻譯（實驗）",
  "version": "0.3.0",
  "description": "在瀏覽器內用 WebGPU 跑 Qwen 小模型：在段落上按右鍵「翻譯這一段」，譯成繁體中文對照。",
  "key": "",
  "minimum_chrome_version": "124",
  "permissions": [
    "storage",
    "offscreen",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "sw.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "本機翻譯"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
